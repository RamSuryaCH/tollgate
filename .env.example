# Copy to .env and edit. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://tollgate:tollgate@127.0.0.1:5432/tollgate
REDIS_URL=redis://127.0.0.1:6379/0

# ollama | mock | openai
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:3b

# Optional OpenAI-compatible endpoint. Leave both empty to disable.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Required for admin endpoints and the CLI. Change before exposing the API.
ADMIN_API_KEY=change-me-admin

CACHE_TTL_SECONDS=3600
DEFAULT_RATE_LIMIT_RPM=60
API_HOST=0.0.0.0
API_PORT=8000

# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000
